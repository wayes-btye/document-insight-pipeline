# Copy to .env and fill in. .env is gitignored — never commit it.
# All values are read by the CLI at startup.
#
# The tool runs without any of these if you pass --mock to the CLI.

# ----------------------------------------------------------------------
# OpenRouter API key. Get one at https://openrouter.ai/keys.
# OpenRouter exposes 100+ models behind one API. Examples that work
# out of the box (selectable via --model):
#
#   openai/gpt-4o-mini           (default; ~$0.025 for 101 docs, fast)
#   openai/gpt-4o                (higher quality, ~17x cost)
#   anthropic/claude-3-5-haiku   (Anthropic's fast tier)
#   anthropic/claude-sonnet-4    (top-tier reasoning, expensive)
#   google/gemini-2.0-flash-exp  (free tier; behaviour varies)
#   meta-llama/llama-3.3-70b-instruct  (open-weight, cheap via OpenRouter)
#
# config.yaml has price entries for the first three; add more there if
# you want cost reporting for other models.
# ----------------------------------------------------------------------
OPENROUTER_API_KEY=
